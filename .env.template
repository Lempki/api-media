# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required. The bearer token every caller must send, at least 16 characters long.
# The service refuses to start with a placeholder such as changeme.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DISCORD_API_SECRET=

# Optional settings follow. The values shown are the defaults.

# Log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# LOG_LEVEL=INFO

# Cache TTL for track metadata (seconds).
# METADATA_CACHE_TTL=3600

# Longest cache time for stream URLs (seconds). YouTube stream URLs expire quickly.
# A URL that expires sooner is dropped 30 seconds before its own expiry.
# STREAM_URL_CACHE_TTL=300

# yt-dlp format string.
# YDL_FORMAT=bestaudio/best

# Maximum search results to return.
# MAX_SEARCH_RESULTS=10

# Spotify — required for Spotify track, album, and playlist support.
# Create an app at https://developer.spotify.com/dashboard and copy the Client ID
# and Client Secret here. Without these, Spotify URLs fall back to a low-quality
# ID-based YouTube search.
# SPOTIFY_CLIENT_ID=your-client-id-here
# SPOTIFY_CLIENT_SECRET=your-client-secret-here
