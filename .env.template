# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required. The bearer token every caller must send, at least 16 characters long.
# The service refuses to start with a placeholder such as changeme.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DISCORD_API_SECRET=

# Optional settings follow. The values shown are the defaults.

# Log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
# LOG_LEVEL=INFO

# Track metadata stays cached for this many seconds.
# METADATA_CACHE_TTL=3600

# Stream URLs stay cached for at most this many seconds, because YouTube stream URLs expire quickly.
# A URL that expires sooner is dropped 30 seconds before its own expiry.
# STREAM_URL_CACHE_TTL=300

# The yt-dlp format selector picks which stream is extracted.
# YDL_FORMAT=bestaudio/best

# /media/search returns at most this many results.
# MAX_SEARCH_RESULTS=10

# Spotify credentials are required for Spotify albums and playlists and for accurate Spotify track matching.
# Create an app at https://developer.spotify.com/dashboard and copy its Client ID and Client Secret here.
# Without them, Spotify track URLs fall back to a low-quality search by track ID, and albums and playlists fail.
# SPOTIFY_CLIENT_ID=your-client-id-here
# SPOTIFY_CLIENT_SECRET=your-client-secret-here
